DATABASE_URL=postgresql://axioma:local-development-only@127.0.0.1:5432/axioma
POSTGRES_PASSWORD=local-development-only
APP_ORIGIN=http://127.0.0.1:5173
INTEGRATION_SECRETS_KEY=replace-with-a-random-secret-at-least-32-characters
# Необязательный серверный ключ DaData; также задается в админке: API интеграции.
DADATA_API_KEY=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Prototype assumption, confirm the commercial agreement before live payments.
COMMISSION_BPS=1500
STORAGE_ROOT=./.local-files
# Секреты и банковские реквизиты задаются только на сервере, не в клиентском коде.
AXIOMA_SELLER_NAME=
AXIOMA_SELLER_INN=
AXIOMA_SELLER_KPP=
AXIOMA_SELLER_ADDRESS=
AXIOMA_SELLER_BANK=
AXIOMA_SELLER_BIC=
AXIOMA_SELLER_ACCOUNT=
AXIOMA_SELLER_CORRESPONDENT_ACCOUNT=
TOCHKA_CUSTOMER_CODE=
TOCHKA_ACCOUNT_ID=
TOCHKA_API_TOKEN=
# По умолчанию https://enter.tochka.com/uapi; для песочницы укажите URL Точки.
TOCHKA_API_URL=
# Обычно ключ получается из публичного JWK endpoint Точки; PEM здесь только для локальных тестов.
TOCHKA_WEBHOOK_PUBLIC_KEY=
